data/ami/*
!data/ami/MANIFEST.json
# Council-meeting pilot (city video segments and Legistar JSON; local only)
data/council/*

# Web build output
web/node_modules/
web/.next/
web/out/
web/.vercel/
web/*.tsbuildinfo

# Claude Code local state (subagent worktrees, settings)
.claude/

# Real-data slice: the user's meetings, questions, answers (private, never commit)
data/real

# Internal working notes (never published)
data/private/
