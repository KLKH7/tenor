# Granola public API key (desktop app → Settings → API; Business/Enterprise plans). Starts with grn_
GRANOLA_API_KEY=
# Optional: override API base URL (default https://public-api.granola.ai)
GRANOLA_API_BASE_URL=
# Used from Phase 3 onwards
ANTHROPIC_API_KEY=
CONCENTRATE_MODEL=
# Hard spend cap per run, in USD (set it to the approved amount; empty = no cap)
CONCENTRATE_MAX_USD=
# Write-time baselines (Graphiti B5): ingestion model (default claude-sonnet-5-5) and effort (default medium)
CONCENTRATE_INGEST_MODEL=
CONCENTRATE_INGEST_EFFORT=
# Enhance speaker model for memory builds: enhance-v1 (default) or enhance-v2
CONCENTRATE_ENHANCER=
# SQLite database path (default data/concentrate.db)
CONCENTRATE_DB=
# Wispr Flow MCP (`tenor sync --source wispr-mcp`): copy the URL from Wispr Flow →
# Settings → MCP → "All other apps" (default https://api.wisprflow.ai/connect/mcp)
WISPR_MCP_URL=
# Optional: where OAuth tokens live, outside the repo (defaults ~/.config/concentrate/{granola,wispr}-mcp.json)
CONCENTRATE_MCP_TOKENS=
CONCENTRATE_WISPR_TOKENS=
# Optional: only for `tenor export braintrust --upload` (the export itself needs no key and no network)
BRAINTRUST_API_KEY=
