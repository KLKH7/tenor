.venv/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Secrets: only .env.example is ever committed
.env
.env.*
!.env.example

# Data: the author's real Granola sync, local databases, caches and regenerable corpora
data/real*
data/*.db
data/cache/
data/fixtures/large/
